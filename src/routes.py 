"""
routes.py — Lazy route fetcher for flight callsigns.

Fetches departure/arrival airports from OpenSky /routes endpoint.
Caches results so each callsign is only fetched once per session.
Rate-limited to avoid hammering the API.
"""
from __future__ import annotations
import time, threading
from typing import Optional
import requests

ROUTES_URL = "https://opensky-network.org/api/routes"
MIN_REQUEST_INTERVAL = 1.2   # seconds between requests


@dataclass  # use a plain class, dataclass needs import
class Route:
    callsign: str
    origin: str       # ICAO code e.g. "OMDB"
    destination: str  # ICAO code e.g. "EGLL"


from dataclasses import dataclass  # fix import order


class RouteCache:
    """
    Thread-safe lazy route fetcher.

    Usage:
        cache = RouteCache()
        route = cache.get("UAE001")   # returns Route or None
        # First call fetches from API; subsequent calls return cached result.
    """

    def __init__(self) -> None:
        self._cache: dict[str, Optional[Route]] = {}
        self._queue: list[str]  = []   # callsigns waiting to be fetched
        self._lock  = threading.Lock()
        self._last_fetch = 0.0

    def request(self, callsign: str) -> None:
        """Queue a callsign for background fetching (non-blocking)."""
        cs = callsign.strip().upper()
        with self._lock:
            if cs not in self._cache and cs not in self._queue:
                self._queue.append(cs)

    def get(self, callsign: str) -> Optional[Route]:
        """Return cached Route or None if not yet fetched / not found."""
        return self._cache.get(callsign.strip().upper())

    def process_queue(self) -> None:
        """
        Fetch one queued callsign. Call this from your poll loop.
        Rate-limited — safe to call every second.
        """
        now = time.time()
        if now - self._last_fetch < MIN_REQUEST_INTERVAL:
            return
        with self._lock:
            if not self._queue:
                return
            callsign = self._queue.pop(0)
        # Fetch outside lock
        route = self._fetch(callsign)
        with self._lock:
            self._cache[callsign] = route   # None if not found
        self._last_fetch = now

    def _fetch(self, callsign: str) -> Optional[Route]:
        try:
            resp = requests.get(
                ROUTES_URL, params={"callsign": callsign}, timeout=5
            )
            if resp.status_code == 404:
                return None           # route not in database
            resp.raise_for_status()
            data = resp.json()
            route_list = data.get("route", [])
            if len(route_list) < 2:
                return None
            return Route(
                callsign    = callsign,
                origin      = route_list[0],
                destination = route_list[-1],
            )
        except Exception as e:
            print(f"[routes] Error fetching {callsign}: {e}")
            return None